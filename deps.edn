{:paths ["src" "resources"]

 :deps {org.clojure/clojure       {:mvn/version "1.12.0"}
        org.clojure/core.async    {:mvn/version "1.6.681"}
        overtone/overtone         {:mvn/version "0.10.6"}
        net.java.dev.jna/jna      {:mvn/version "5.14.0"}
        net.java.dev.jna/jna-platform {:mvn/version "5.14.0"}}

 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps  {io.github.cognitect-labs/test-runner
                 {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts   ["-m" "cognitect.test-runner"]
   :exec-fn     cognitect.test-runner.api/test}

  ;; CI alias: filters to pure namespaces only (no audio hardware needed)
  :test-ci
  {:extra-paths ["test"]
   :extra-deps  {io.github.cognitect-labs/test-runner
                 {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :exec-fn     cognitect.test-runner.api/test
   :exec-args   {:namespace-regex ["cantor\\.core\\..*"]}}}}
