{:paths ["src" "resources"]

 :deps {org.clojure/clojure           {:mvn/version "1.12.0"}
        org.clojure/core.async        {:mvn/version "1.6.681"}
        overtone/overtone             {:mvn/version "0.16.3331"}
        net.java.dev.jna/jna          {:mvn/version "5.14.0"}
        net.java.dev.jna/jna-platform {:mvn/version "5.14.0"}}

 :aliases
 {:dev
  {:extra-paths ["dev"]}

  :test
  {:extra-paths ["test"]
   :extra-deps  {io.github.cognitect-labs/test-runner
                 {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts   ["-m" "cognitect.test-runner"]
   :exec-fn     cognitect.test-runner.api/test}

  ;; CI/pre-push alias: replaces deps entirely to exclude Overtone/JNA (x86_64 native libs
  ;; crash on arm64 at class-init time even when no test touches audio)
  :test-ci
  {:replace-deps  {org.clojure/clojure    {:mvn/version "1.12.0"}
                   org.clojure/core.async {:mvn/version "1.6.681"}
                   io.github.cognitect-labs/test-runner
                   {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :replace-paths ["src" "test"]
   :exec-fn       cognitect.test-runner.api/test
   :exec-args     {:namespace-regex ["cantor\\.core\\..*"]}}}}
